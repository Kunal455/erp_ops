# Server Port
PORT=5000
NODE_ENV=development

# MySQL Database URL format:
# mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Example with Docker default:
DATABASE_URL="mysql://erp_user:erp_secret_pass@localhost:3306/fundsroom_erp"

# Example with local root user (XAMPP / MySQL Workbench):
# DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/fundsroom_erp"

# JWT Authentication Secret Key
JWT_SECRET="fundsroom_erp_super_secure_jwt_secret_key_2026_xyz"
JWT_EXPIRES_IN="7d"
