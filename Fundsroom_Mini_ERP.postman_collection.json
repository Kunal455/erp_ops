{
  "info": {
    "name": "Mini Operations ERP API Collection",
    "description": "Comprehensive Postman collection with 3-Role Signups & Logins, and end-to-end router testing across Inventory, Work Orders, Transfers, and Customer Orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "opsToken", "value": "" },
    { "key": "salesToken", "value": "" },
    { "key": "locNorthId", "value": "" },
    { "key": "locSouthId", "value": "" },
    { "key": "itemSteelId", "value": "" },
    { "key": "itemMotorId", "value": "" },
    { "key": "workOrderId", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication (3 Role Signups & Logins)",
      "item": [
        {
          "name": "1.1. Signup - Admin Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Admin\",\n  \"email\": \"admin.demo@fundsroom.com\",\n  \"password\": \"admin123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "1.2. Login - Admin (Captures adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('adminToken', json.data.token);",
                  "  console.log('Saved adminToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.3. Signup - Operations Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Operations\",\n  \"email\": \"ops.demo@fundsroom.com\",\n  \"password\": \"ops123\",\n  \"role\": \"OPERATIONS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "1.4. Login - Operations (Captures opsToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('opsToken', json.data.token);",
                  "  console.log('Saved opsToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ops@fundsroom.com\",\n  \"password\": \"ops123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.5. Signup - Sales Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Charlie Sales\",\n  \"email\": \"sales.demo@fundsroom.com\",\n  \"password\": \"sales123\",\n  \"role\": \"SALES\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "1.6. Login - Sales (Captures salesToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('salesToken', json.data.token);",
                  "  console.log('Saved salesToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@fundsroom.com\",\n  \"password\": \"sales123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.7. Get Current Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "1.8. List All System Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/users", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users"] }
          }
        }
      ]
    },
    {
      "name": "2. Inventory Router (/api/inventory)",
      "item": [
        {
          "name": "2.1. List Warehouse Locations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length >= 2) {",
                  "  pm.collectionVariables.set('locNorthId', json.data[0].id);",
                  "  pm.collectionVariables.set('locSouthId', json.data[1].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/locations", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "locations"] }
          }
        },
        {
          "name": "2.2. List Master Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length >= 2) {",
                  "  pm.collectionVariables.set('itemSteelId', json.data[0].id);",
                  "  pm.collectionVariables.set('itemMotorId', json.data[2] ? json.data[2].id : json.data[1].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/items", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "items"] }
          }
        },
        {
          "name": "2.3. Get Multi-Location Inventory (Live Available Stock)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory", "host": ["{{baseUrl}}"], "path": ["api", "inventory"] }
          }
        },
        {
          "name": "2.4. Stock Inward (Stock-In)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemSteelId}}\",\n  \"locationId\": \"{{locNorthId}}\",\n  \"batchNumber\": \"BAT-ST-005\",\n  \"quantity\": 200,\n  \"notes\": \"New steel plate shipment from primary supplier\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/inventory/stock-in", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "stock-in"] }
          }
        },
        {
          "name": "2.5. Stock Adjustment (Cycle Count)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemSteelId}}\",\n  \"locationId\": \"{{locNorthId}}\",\n  \"batchNumber\": \"BAT-ST-001\",\n  \"newPhysicalQuantity\": 510,\n  \"notes\": \"Audit adjustment post physical cycle count\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "adjust"] }
          }
        },
        {
          "name": "2.6. Get Stock Transactions History (Audit Log)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/transactions?limit=50", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "transactions"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    },
    {
      "name": "3. Work Orders Router (/api/work-orders)",
      "item": [
        {
          "name": "3.1. Compute Shortage (Formula: max(Req - Avail, 0))",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/stock-check/calculate?locationId={{locSouthId}}&itemId={{itemMotorId}}&requiredQuantity=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders", "stock-check", "calculate"],
              "query": [
                { "key": "locationId", "value": "{{locSouthId}}" },
                { "key": "itemId", "value": "{{itemMotorId}}" },
                { "key": "requiredQuantity", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "3.2. Create Work Order (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('workOrderId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locationId\": \"{{locSouthId}}\",\n  \"itemId\": \"{{itemMotorId}}\",\n  \"requiredQuantity\": 15,\n  \"notes\": \"Production batch for industrial client\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders", "host": ["{{baseUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "3.3. List All Work Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/work-orders", "host": ["{{baseUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "3.4. Update WO Status (ASSIGNED -> IN_PROGRESS)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}", "status"] }
          }
        },
        {
          "name": "3.5. Update WO Status (IN_PROGRESS -> COMPLETED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/work-orders/{{workOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "work-orders", "{{workOrderId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "4. Transfers Router (/api/transfers)",
      "item": [
        {
          "name": "4.1. Request Inter-Warehouse Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('transferId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{opsToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceLocationId\": \"{{locNorthId}}\",\n  \"destinationLocationId\": \"{{locSouthId}}\",\n  \"itemId\": \"{{itemSteelId}}\",\n  \"batchNumber\": \"BAT-ST-001\",\n  \"quantity\": 20\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/transfers", "host": ["{{baseUrl}}"], "path": ["api", "transfers"] }
          }
        },
        {
          "name": "4.2. Dispatch Transfer (Origin Stock Decreases)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{opsToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transfers/{{transferId}}/dispatch", "host": ["{{baseUrl}}"], "path": ["api", "transfers", "{{transferId}}", "dispatch"] }
          }
        },
        {
          "name": "4.3. Receive Transfer (Destination Stock Increases)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{opsToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transfers/{{transferId}}/receive", "host": ["{{baseUrl}}"], "path": ["api", "transfers", "{{transferId}}", "receive"] }
          }
        },
        {
          "name": "4.4. List All Stock Transfers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{opsToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transfers", "host": ["{{baseUrl}}"], "path": ["api", "transfers"] }
          }
        }
      ]
    },
    {
      "name": "5. Orders Router (/api/orders)",
      "item": [
        {
          "name": "5.1. Create Customer Order (Status: DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('orderId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{salesToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Vanguard Manufacturing Systems\",\n  \"locationId\": \"{{locNorthId}}\",\n  \"items\": [\n    {\n      \"itemId\": \"{{itemMotorId}}\",\n      \"batchNumber\": \"BAT-MOT-001\",\n      \"quantity\": 5,\n      \"unitPrice\": 1500\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "5.2. Reserve Order Stock (Row-Level Locking Transaction)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/reserve", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "reserve"] }
          }
        },
        {
          "name": "5.3. Fulfill Order (Consumes Physical & Reserved Stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/fulfill", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "fulfill"] }
          }
        },
        {
          "name": "5.4. List Customer Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        }
      ]
    }
  ]
}
